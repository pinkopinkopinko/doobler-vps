# =====================================================================
# Production env для Дублера. Скопировать в /opt/doobler/.env.production
# и заполнить все непустые значения.
#
# Сгенерировать секреты можно через:
#     bash deploy/scripts/gen-secrets.sh
# =====================================================================

# ---- App ------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Публичный URL приложения (без слэша на конце).
# Используется в bot/webhook ссылках, в редиректах и в Telegram menu button.
NEXT_PUBLIC_APP_URL=https://example.ru
NEXT_PUBLIC_APP_NAME=Дублер

# ---- Postgres -------------------------------------------------------
# Хост обязательно `postgres` — это имя сервиса в docker-compose.
POSTGRES_DB=doobler
POSTGRES_USER=doobler
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql://doobler:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/doobler?schema=public

# ---- Сессии ---------------------------------------------------------
# `openssl rand -base64 64`
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ---- Telegram -------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_BOT_USERNAME=CHANGE_ME_BOT_USERNAME
# `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_HEX_32

# ---- Админка --------------------------------------------------------
ADMIN_LOGIN=admin
# `npm run admin:hash-password`  (запускать локально)
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
# В проде plaintext-пароль игнорируется, поле должно быть пустым.
ADMIN_PASSWORD=

# ---- Uploads --------------------------------------------------------
# Внутри контейнера.
UPLOADS_DIR=/var/lib/doobler/uploads

# ---- Dev fallbacks (в проде ОБЯЗАТЕЛЬНО false) ----------------------
ALLOW_DEV_AUTH_FALLBACK=false
ALLOW_DEV_DATA_FALLBACK=false

# ---- Логирование ----------------------------------------------------
LOG_VERBOSE=false
NEXT_PUBLIC_LOG_VERBOSE=false

# ---- Acme / certbot -------------------------------------------------
# Email для Let's Encrypt уведомлений о просрочке сертификата.
ACME_EMAIL=admin@example.ru
# Домен, на который выпускаем сертификат. Должен совпадать с
# хостом из NEXT_PUBLIC_APP_URL.
DOMAIN=example.ru
