# =====================================================================
# Production env для Дублера. Скопировать в /opt/doobler/.env.production
# и заполнить все непустые значения.
#
# Сгенерировать секреты можно через:
#     bash deploy/scripts/gen-secrets.sh
# =====================================================================

# ---- App ------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Публичный URL приложения (без слэша на конце).
# Используется в bot/webhook ссылках, в редиректах и в Telegram menu button.
NEXT_PUBLIC_APP_URL=https://example.ru
NEXT_PUBLIC_APP_NAME=Дублер

# ---- Postgres -------------------------------------------------------
# Хост обязательно `postgres` — это имя сервиса в docker-compose.
POSTGRES_DB=doobler
POSTGRES_USER=doobler
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql://doobler:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/doobler?schema=public

# ---- Сессии ---------------------------------------------------------
# `openssl rand -base64 64`
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ---- Telegram -------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_BOT_USERNAME=CHANGE_ME_BOT_USERNAME
# `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_HEX_32

# ---- MAX ----------------------------------------------------------------
MAX_BOT_TOKEN=CHANGE_ME_MAX_BOT_TOKEN
MAX_BOT_URL=https://max.ru/id163205081110_bot
# `openssl rand -hex 32`
MAX_WEBHOOK_SECRET=CHANGE_ME_HEX_32

# ---- Админка --------------------------------------------------------
ADMIN_LOGIN=admin
# `npm run admin:hash-password`  (запускать локально)
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
# В проде plaintext-пароль игнорируется, поле должно быть пустым.
ADMIN_PASSWORD=

# ---- Uploads --------------------------------------------------------
# Внутри контейнера.
UPLOADS_DIR=/var/lib/doobler/uploads

# ---- Dev fallbacks (в проде ОБЯЗАТЕЛЬНО false) ----------------------
ALLOW_DEV_AUTH_FALLBACK=false
ALLOW_DEV_DATA_FALLBACK=false

# ---- Логирование ----------------------------------------------------
LOG_VERBOSE=false
NEXT_PUBLIC_LOG_VERBOSE=false

# ---- DaData ---------------------------------------------------------
# API-ключ DaData Suggestions API. Нужен для подсказок адресов и проверки
# района/координат при создании смены.
DADATA_API_KEY=CHANGE_ME_DADATA_API_KEY

# ---- Acme / certbot -------------------------------------------------
# Email для Let's Encrypt уведомлений о просрочке сертификата.
ACME_EMAIL=admin@example.ru
# Домен, на который выпускаем сертификат. Должен совпадать с
# хостом из NEXT_PUBLIC_APP_URL.
DOMAIN=example.ru

# ---- Support-bot ----------------------------------------------------
# Отдельный Telegram-бот техподдержки. Создать через @BotFather, токен
# вставить сюда. Это НЕ TELEGRAM_BOT_TOKEN основного приложения.
SUPPORT_BOT_TOKEN=CHANGE_ME_SUPPORT_BOT_TOKEN
# Telegram chat ID администратора, которому пересылаются обращения.
SUPPORT_ADMIN_CHAT_ID=6344041488
# Лимит размера вложений (байты, по умолчанию 10 MB).
SUPPORT_MAX_FILE_BYTES=10485760
# Минимальный интервал между сообщениями одного юзера (секунды).
SUPPORT_MESSAGE_INTERVAL_SECONDS=5

# ---- Outbound proxy (опционально) -----------------------------------
# Если VPS в РФ и api.telegram.org / DaData недоступны напрямую — пропиши
# HTTP-прокси с авторизацией. Поднимется и на app, и на support-bot.
# Оставить пустым если прокси не нужен.
# Пример: http://USER:PASS@HOST:PORT
HTTPS_PROXY=
HTTP_PROXY=

# ---- SEO / Analytics (опционально) -----------------------------------
# Подтверждение прав в Yandex.Webmaster и Google Search Console.
# Получаются после регистрации сайта doobler.ru в соответствующем сервисе.
# Если пусто — meta-тег не рендерится.
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# Счётчики посещаемости. Если пусто — скрипт не загружается.
# Yandex.Metrika: номер счётчика (8-9 цифр), без префиксов и кавычек.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Google Analytics 4: Measurement ID вида G-XXXXXXXXXX.
